# ============================================
# Databricks Auth Configuration
# ============================================
# First, run: databricks auth login --profile accounting-triage
DATABRICKS_CONFIG_PROFILE=accounting-triage

# ============================================
# Agent Serving Configuration
# ============================================
# Set this to your deployed Accounting Triage Agent serving endpoint
DATABRICKS_SERVING_ENDPOINT=accounting-triage-agent

# ============================================
# Chat UI Configuration
# ============================================
CHAT_GREETING=Hi! I'm the Accounting Request Triage Assistant. I can help you determine if your issue can be resolved by Transaction Management, or if it needs to be routed to Accounting or another team. What's your question?

# ============================================
# Database Configuration (Optional - for persistent chat history)
# ============================================
# PGUSER=your-databricks-username
# PGHOST=your-postgres-host
# PGDATABASE=databricks_postgres
# PGPORT=5432

# ============================================
# Feedback Configuration (Optional)
# ============================================
# MLFLOW_EXPERIMENT_ID=/Users/your-email@company.com/accounting-triage-feedback
